
// METHOD 1: EXTENDING THREAD CLASS

class GoodMorningThread extends Thread {
    public void run() {
        while (true) {
            System.out.println("Good Morning");
            try {
                Thread.sleep(1000);
            } catch (InterruptedException e) {
                break;
            }
        }
    }
}

class HelloThread extends Thread {
    public void run() {
        while (true) {
            System.out.println("Hello");
            try {
                Thread.sleep(2000);
            } catch (InterruptedException e) {
                break;
            }
        }
    }
}

class WelcomeThread extends Thread {
    public void run() {
        while (true) {
            System.out.println("Welcome");
            try {
                Thread.sleep(3000);
            } catch (InterruptedException e) {
                break;
            }
        }
    }
}


// METHOD 2: IMPLEMENTING RUNNABLE INTERFACE

class GoodMorningRunnable implements Runnable {
    public void run() {
        while (true) {
            System.out.println("Good Morning");
            try {
                Thread.sleep(1000);
            } catch (InterruptedException e) {
                break;
            }
        }
    }
}

class HelloRunnable implements Runnable {
    public void run() {
        while (true) {
            System.out.println("Hello");
            try {
                Thread.sleep(2000);
            } catch (InterruptedException e) {
                break;
            }
        }
    }
}

class WelcomeRunnable implements Runnable {
    public void run() {
        while (true) {
            System.out.println("Welcome");
            try {
                Thread.sleep(3000);
            } catch (InterruptedException e) {
                break;
            }
        }
    }
}


// MAIN CLASS

public class Main {
    public static void main(String[] args) {

        // Method 1: Extending Thread Class
        GoodMorningThread t1 = new GoodMorningThread();
        HelloThread t2 = new HelloThread();
        WelcomeThread t3 = new WelcomeThread();

        t1.start();
        t2.start();
        t3.start();


        // Method 2: Implementing Runnable Interface
        GoodMorningRunnable r1 = new GoodMorningRunnable();
        HelloRunnable r2 = new HelloRunnable();
        WelcomeRunnable r3 = new WelcomeRunnable();

        Thread t4 = new Thread(r1);
        Thread t5 = new Thread(r2);
        Thread t6 = new Thread(r3);

        t4.start();
        t5.start();
        t6.start();
    }
}
